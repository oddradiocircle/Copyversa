{
    "name": "copyversa",
    "version": "4.0.0",
    "private": true,
    "description": "Copia contenido web como Markdown, texto plano o texto enriquecido, conservando su estructura.",
    "license": "MIT",
    "author": "Daniel Gómez-Padilla",
    "homepage": "https://github.com/oddradiocircle/Copyversa#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oddradiocircle/Copyversa.git"
    },
    "bugs": "https://github.com/oddradiocircle/Copyversa/issues",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "node scripts/build.mjs --watch",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:e2e": "npm run build && playwright test",
        "check": "npm run lint && npm test && npm run test:e2e"
    },
    "dependencies": {
        "turndown": "^7.2.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "vitest": "^5.0.5"
    }
}
